# Isolated B-bot live stub unit.
# Do not install or overwrite any collector / D storage unit.
# Paths and locks are BBOT-only (/data/bbot, never D trees).
# Do not systemctl enable without a Validation snapshot of collector NRestarts.
# This file is not enabled on the VPS by creating it in the repo.

[Unit]
Description=Spread B-bot live stub (isolated from collector)
After=network-online.target
Wants=network-online.target
# Do NOT After= or BindsTo= spread-collector

[Service]
Type=simple
User=root
WorkingDirectory=/root/spread_staging
Environment=BBOT_DATA_ROOT=/data/bbot
Environment=BBOT_LOG_PATH=/var/log/spread/bbot.log
Environment=BBOT_COINS=BTC,ETH
Environment=BBOT_MODE=probe
Environment=BBOT_NOTIONAL_USDT=100
Environment=BBOT_TRADE_LAT_MS=100
# NO SPREAD_* vars, NO BACKUP_RCLONE_PATH=spread-compacted, NO API keys
ExecStartPre=/usr/bin/mkdir -p /data/bbot /var/log/spread
ExecStart=/root/venv/bin/python -m app.bot
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/var/log/spread/bbot.log
StandardError=append:/var/log/spread/bbot.log
MemoryMax=256M
CPUQuota=15%
LimitNOFILE=4096
Nice=10
ReadWritePaths=/data/bbot /var/log/spread
InaccessiblePaths=/data/live /data/bars /data/compacted /data/spool

[Install]
WantedBy=multi-user.target
