# Git template only. Do NOT systemctl enable or start in this change.
# Isolated HL v2 canary: Bybit+OKX staff + sharded HL l2Book → /data/live_hl_v2.
# Never writes /data/live. Mirrors isolation of prior HL/hotadd canaries.
#
# Experiment (N=1 socket, ~88 Bybit∩OKX∩HL coins):
#   See docs/hl-v2-canary.md
#
# Do NOT:
#   - point SPREAD_PARQUET_ROOT / HL_V2_PARQUET_ROOT at /data/live
#   - enable this unit on a host without an explicit separate deploy step
#   - merge into spread-collector-next wiring
[Unit]
Description=Spread collector HL v2 canary (sharded l2Book; template, not enabled)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/spread_hl_v2
Environment=SPREAD_UNIVERSE=/root/spread_hl_v2/bybit_okx_universe.csv
Environment=HL_V2_UNIVERSE=/root/spread_hl_v2/bybit_okx_universe.csv
Environment=SPREAD_PARQUET_ROOT=/data/live_hl_v2
Environment=HL_V2_PARQUET_ROOT=/data/live_hl_v2
Environment=SPREAD_SPOOL_ROOT=/data/spool_hl_v2
Environment=HL_V2_SPOOL_ROOT=/data/spool_hl_v2
Environment=SPREAD_GAPS_ROOT=/data/gaps_hl_v2
Environment=HL_V2_GAPS_ROOT=/data/gaps_hl_v2
Environment=HL_V2_RUNTIME_LOG=/var/log/spread/hl-v2-runtime.log
Environment=HL_V2_FAILED_BATCHES_LOG=/var/log/spread/hl-v2-failed-batches.log
Environment=HL_SOCKET_COUNT=1
Environment=HL_CHANNELS=l2Book
Environment=SPREAD_WS_RECONNECT_V2=1
Environment=SPREAD_WS_CONNECT_PER_SEC=3
Environment=HL_WS_URL=wss://api.hyperliquid.xyz/ws
Environment=HL_INFO_URL=https://api.hyperliquid.xyz/info
ExecStartPre=/usr/bin/mkdir -p /data/live_hl_v2 /data/spool_hl_v2 /data/gaps_hl_v2 /var/log/spread
ExecStart=/root/venv/bin/python -m app.hl_v2
LimitNOFILE=65535
# Block prod D trees (mirror hotadd / prior HL canary isolation).
InaccessiblePaths=/data/live /data/spool /data/spool-next /data/bars /data/bars-next /data/compacted /data/gaps /data/gaps-next
Restart=on-failure
RestartSec=30
KillSignal=SIGTERM
TimeoutStopSec=120
StandardOutput=journal
StandardError=journal

# Intentionally no [Install] WantedBy — copy/enable only after an explicit deploy gate.
