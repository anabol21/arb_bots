[Unit]
Description=Spread B-bot prod would_send (hot-add expand-only; stub/no live orders)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
EnvironmentFile=/etc/spread/sentry-strategist.env
Type=simple
User=root
WorkingDirectory=/root/spread_bbot_would_send_prod
Environment=PYTHONPATH=/root/spread_bbot_would_send_prod
Environment=BBOT_MODE=policy
Environment=BBOT_PROFILE=gear22_would_send
Environment=BBOT_BROKER=stub
Environment=BBOT_NOTIONAL_USDT=20
Environment=BBOT_SIZE_GATE=0
Environment=BBOT_TRADE_LAT_MS=100
Environment=BBOT_FLOOR_WATCH=1
Environment=BBOT_TW_P50_WATCH=1
Environment=BBOT_THETA_WATCH=1
Environment=BBOT_THETA_TRADE=1
Environment=BBOT_THETA_OPEN=0.50
Environment=BBOT_P50_OPEN=0.60
Environment=BBOT_MIN_PROFIT_PP=0.20
Environment=BBOT_MIN_THETA_CLOSE=0.05
Environment=BBOT_FEE_RT_PP=0.30
Environment=BBOT_FILL_DELAY_MS=70
Environment=BBOT_SLOT_K=1
Environment=BBOT_DATA_ROOT=/data/bbot-would-send-prod
Environment=BBOT_LOG_PATH=/var/log/spread/bbot-would-send-prod.log
Environment=BBOT_FLOOR_WARM=1
Environment=BBOT_FLOOR_WARM_PATH=/data/bbot-would-send-prod/state/floor_warm.pkl
Environment=BBOT_HOT_ADD=1
Environment=BBOT_HOT_ADD_WARM=1
Environment=BBOT_HOT_ADD_HISTORY_ROOT=/data/bbot-would-send-prod-history
Environment=BBOT_HOT_ADD_HISTORY_HOURS=12
Environment=BBOT_HOT_ADD_HISTORY_MIN_SMA12=40
Environment=BBOT_HOT_ADD_MAX_EXTRA=48
Environment=BBOT_HOT_ADD_POLL_SEC=30
Environment=BBOT_HOT_ADD_DELTA=/data/bbot-would-send-prod/hot_add_delta.csv
Environment=BBOT_HOT_ADD_DROP=/data/bbot-would-send-prod/hot_add_drop.csv
Environment=BBOT_COINS=KAITO,HOME,WAL,RVN,ONT,2Z,BICO,HMSTR,CAP,BLEND,EDEN,KMNO,GPS,ME,ZBT,MOVE,COAI,AZTEC,APR,YB,AT,H,MUBARAK,ACU,LA,BEAT,PARTI,SIGN,GIGGLE
Environment=SPREAD_TICK_AGE_MAX_MS=10000
Environment=SPREAD_TICK_SKEW_MAX_MS=10000
ExecStart=/root/venv/bin/python -m app.bot
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/var/log/spread/bbot-would-send-prod.log
StandardError=append:/var/log/spread/bbot-would-send-prod.log
MemoryMax=2G
CPUQuota=100%
LimitNOFILE=8192
Nice=10
ReadWritePaths=/data/bbot-would-send-prod /var/log/spread
ReadOnlyPaths=/data/bbot-would-send-prod-history
InaccessiblePaths=/data/live /data/bars /data/compacted /data/spool

[Install]
WantedBy=multi-user.target
